{
  "openapi": "3.1.0",
  "info": {
    "title": "Sunset Rollercoaster API",
    "description": "Read-only REST API for Taipower electricity data, Taiwan and international fuel prices, invoice draws, and reservoir records.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/fuel-prices": {
      "get": {
        "tags": [
          "fuel-prices"
        ],
        "operationId": "list_fuel_prices",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "description": "Exact period start date in Asia/Taipei (YYYY-MM-DD).",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Inclusive lower bound on the period start date in Asia/Taipei (YYYY-MM-DD).",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "Inclusive upper bound on the period start date in Asia/Taipei (YYYY-MM-DD).",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 100,
              "maximum": 1000,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List weekly Taiwan fuel and international crude oil prices filtered by period start date",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NationwideFuelPrice"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/fuel-prices/latest": {
      "get": {
        "tags": [
          "fuel-prices"
        ],
        "operationId": "latest_fuel_price",
        "responses": {
          "200": {
            "description": "Most recent weekly Taiwan fuel and international crude oil prices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NationwideFuelPrice"
                }
              }
            }
          },
          "404": {
            "description": "No data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/fuel-prices/{id}": {
      "get": {
        "tags": [
          "fuel-prices"
        ],
        "operationId": "get_fuel_price",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Fuel price record id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fuel price record detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NationwideFuelPrice"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
