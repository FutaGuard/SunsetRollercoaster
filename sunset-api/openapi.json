    "/taipower/power-snapshots": {
      "get": {
        "tags": [
          "taipower"
        ],
        "operationId": "list_power_snapshots",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "description": "Exact local date in Asia/Taipei (YYYY-MM-DD).",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Inclusive UTC timestamp lower bound (RFC3339). Ignored when `date` is set.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "Inclusive UTC timestamp upper bound (RFC3339). Ignored when `date` is set.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 500,
              "maximum": 5000,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List Taipower current-load and peak forecast snapshots; power values are MW",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaipowerPowerSnapshot"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/taipower/power-snapshots/latest": {
      "get": {
        "tags": [
          "taipower"
        ],
        "operationId": "latest_power_snapshot",
        "responses": {
          "200": {
            "description": "Latest Taipower current-load and peak forecast snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaipowerPowerSnapshot"
                }
              }
            }
          },
          "404": {
            "description": "No data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
