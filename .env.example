# Cloudflare Tunnel token. Get it from:
#   Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels
#   -> Create a tunnel (Cloudflared) -> copy the token shown under
#      "Install and run a connector".
TUNNEL_TOKEN=

# Rust log filter (optional). Examples:
#   info, debug, sunset_api=debug,tower_http=info
RUST_LOG=info
